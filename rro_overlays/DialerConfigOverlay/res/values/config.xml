         RoleManager.getRoleHolders(ROLE_DIALER) list when no default dialer
         is assigned (config_defaultDialer defaults to com.android.dialer which
         is not installed on this target). -->
    <string name="config_defaultDialer" translatable="false">com.android.car.dialer</string>
</resources>
